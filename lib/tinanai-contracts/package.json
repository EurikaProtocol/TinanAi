{
  "name": "@workspace/tinanai-contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./mainnet-identity": "./src/mainnet-identity.ts",
    "./token-artifact": "./src/generated-token-artifact.ts",
    ".": "./src/index.ts",
    "./abis": "./src/generated-abis.ts",
    "./abi/TinanAiToken.json": "./abi/TinanAiToken.json",
    "./abi/TinanAiCore.json": "./abi/TinanAiCore.json"
  },
  "scripts": {
    "compile": "hardhat build && node scripts/export-abis.mjs",
    "build": "pnpm run compile",
    "test": "pnpm run compile && hardhat test nodejs",
    "typecheck": "pnpm run compile && tsc -p tsconfig.tools.json --noEmit",
    "deploy:local": "pnpm run compile && hardhat run scripts/deploy.ts --network hardhatLocal",
    "deploy:sepolia": "pnpm run compile && hardhat run scripts/deploy.ts --network sepolia",
    "deploy:mainnet": "node scripts/mainnet-command.mjs deploy",
    "verify:mainnet": "node scripts/mainnet-command.mjs verify"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "pg": "^8.23.0",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-node-test-runner": "3.1.2",
    "@nomicfoundation/hardhat-viem": "3.1.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@walletconnect/universal-provider": "2.26.0",
    "hardhat": "3.21.2",
    "qrcode-terminal": "0.12.0",
    "solc": "0.8.38"
  }
}
