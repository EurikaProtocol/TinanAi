  "private": true,
  "type": "module",
  "scripts": {
    "compile:token": "node scripts/compile-token.mjs",
    "dev": "pnpm run compile:token && vite --config vite.config.ts --host 0.0.0.0",
    "build": "pnpm run compile:token && PORT=${PORT:-22481} BASE_PATH=${BASE_PATH:-/} vite build --config vite.config.ts && node scripts/check-bundle-budget.mjs",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "pnpm run compile:token && tsc -p tsconfig.json --noEmit",
    "test:payment-readiness": "node --experimental-strip-types --test src/lib/payment-readiness.test.ts src/lib/wallet-observation.test.ts",
    "test:wallet-session": "node --experimental-strip-types --test src/lib/wallet-session-transition.test.ts src/lib/wallet-observation.test.ts",
    "test:dependencies": "node --test src/lib/dependency-compatibility.test.mjs",
    "test": "pnpm run compile:token && node --experimental-strip-types --test src/lib/greenleaf.test.ts src/lib/i18n/i18n.test.ts src/lib/project-preview.test.ts src/lib/eureka-core.test.ts src/lib/builder-request-errors.test.ts src/lib/builder-editor.test.ts src/lib/launchpad.test.ts src/lib/launchpad-deployment.test.ts src/lib/web3-contracts.test.ts src/lib/data-token-projects.test.ts"
  },
