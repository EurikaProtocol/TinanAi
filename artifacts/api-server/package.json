{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "pnpm --filter @workspace/tinanai-contracts run compile && node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "node --experimental-strip-types --test src/lib/builder-agent-agents.test.ts src/lib/builder-files.test.ts src/lib/builder-generation.test.ts src/lib/builder-project-validation.test.ts src/lib/cors-origin.test.ts src/lib/fixed-window-rate-limit.test.ts src/lib/greenleaf-mode.test.ts src/lib/knowledge-files.test.ts src/lib/knowledge-grounding.test.ts src/lib/request-array-bounds.test.ts src/lib/response-language.test.ts src/lib/tinanai-research.test.mjs",
    "test:knowledge-isolation": "node scripts/knowledge-account-isolation.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:payments": "node scripts/test-payments.mjs",
    "test:payment-admin": "node scripts/test-payment-admin.mjs",
    "mainnet:preflight": "node scripts/mainnet-preflight.mjs",
    "test:mainnet": "node scripts/test-mainnet.mjs",
    "test:dependencies": "node scripts/test-dependencies.mjs",
    "payments:admin": "node scripts/payment-admin.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.83",
    "@clerk/shared": "^4.41.1",
    "@huggingface/transformers": "^4.3.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "@workspace/tinanai-contracts": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "onnxruntime-node": "1.30.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5",
    "solc": "^0.8.38",
    "viem": "2.57.16",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "catalog:",
    "@types/papaparse": "^5.5.2",
    "@types/yauzl": "^3.4.0",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
