# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
generated-artifacts/
lib/tinanai-contracts/deployments/local.json
lib/tinanai-contracts/deployments/sepolia.json
lib/tinanai-contracts/deployments/mainnet.json
lib/tinanai-contracts/deployments/mainnet.lock
lib/tinanai-contracts/deployments/*.json.tmp
lib/tinanai-contracts/generated-artifacts/
.agents/
attached_assets/
