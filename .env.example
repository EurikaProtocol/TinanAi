# Public (browser-exposed) config. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SITE_URL=https://www.tinaneureka.com
# Optional endpoint that proxies your AI provider (keep API keys server-side in that proxy)
NEXT_PUBLIC_AI_API_URL=
# Existing token (network not assumed). Never redeployed by this app.
NEXT_PUBLIC_EXISTING_TOKEN_ADDRESS=0x4042973c0863CCA0D73F028cA98465F44F0e6F97
NEXT_PUBLIC_EXISTING_TOKEN_CHAIN_ID=
# Per-chain public RPC URLs (suffix: ETHEREUM, BASE, ARBITRUM, POLYGON, BNB)
NEXT_PUBLIC_RPC_ETHEREUM=
NEXT_PUBLIC_RPC_BASE=
NEXT_PUBLIC_RPC_ARBITRUM=
NEXT_PUBLIC_RPC_POLYGON=
NEXT_PUBLIC_RPC_BNB=
# Deployed contract addresses per chain
NEXT_PUBLIC_TOKEN_FACTORY_BASE=
NEXT_PUBLIC_PROJECT_REGISTRY_BASE=
NEXT_PUBLIC_DATA_PROOF_REGISTRY_BASE=
# (same pattern for _ETHEREUM, _ARBITRUM, _POLYGON, _BNB)
