# Template only. Put real credentials in Replit Secrets, not in this file.
# Replit workflows provide PORT and BASE_PATH for the web services.
DATABASE_URL=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=
VITE_REOWN_PROJECT_ID=

# Optional server-side AI Integration values for local development.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Leave empty for same-origin browser/API requests. Cross-origin access requires
# an exact comma-separated list of HTTPS origins; localhost HTTP is dev-only.
TINANAI_CORS_ALLOWED_ORIGINS=

# Optional chain configuration. Use Replit Secrets for credential-bearing RPC URLs.
SEPOLIA_RPC_URL=
TINANAI_MAINNET_RPC_URL=
TINANAI_MAINNET_AUTHORIZED_DEPLOYER=
TINANAI_MAINNET_PAYMENT_CATALOG_URL=
TINANAI_MAINNET_KNOWN_TOKEN_ADDRESS=
TINANAI_MAINNET_VERIFY_ADDRESS=
TINANAI_MAINNET_SIMULATION_AUTHORIZATION=
